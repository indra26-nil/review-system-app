# RevMap build-time configuration.
#
# Copy to `.env` and fill in the values. `.env` is gitignored and is never
# read into source — the build script passes each value through as a
# --dart-define, and Dart reads them via String.fromEnvironment.
#
# Get these from supabase.com -> your project -> Settings -> API.

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The "anon" / "public" key (the long eyJhbGci... value).
# Safe to ship in the app: Supabase relies on row-level security, not on
# hiding this key. NEVER put the service_role key here or in the app —
# it bypasses row-level security entirely and must stay server-side.
SUPABASE_ANON_KEY=

# Enables the simulator screen. Keep false for anything real.
DEMO_MODE=false
